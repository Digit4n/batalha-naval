algoritmo "BatalhaNaval"

var
 chance: inteiro
 totalNa: inteiro
 oceano :matriz[0..5, 0..5] de caractere
 posicaoUser: caractere
 posicao1:inteiro
 posicao2: inteiro
 
inicio
 oceano[0, 0] <- "D"
 oceano[0, 1] <- "v"
 oceano[0, 2] <- "v"
 oceano[0, 3] <- "v"
 oceano[0, 4] <- "v"
 oceano[0, 5] <- "v"

 oceano[1, 0] <- "D"
 oceano[1, 1] <- "v"
 oceano[1, 2] <- "v"
 oceano[1, 3] <- "v"
 oceano[1, 4] <- "v"
 oceano[1, 5] <- "v"

 oceano[2, 0] <- "D"
 oceano[2, 1] <- "v"
 oceano[2, 2] <- "v"
 oceano[2, 3] <- "v"
 oceano[2, 4] <- "N"
 oceano[2, 5] <- "v"

 oceano[3, 0] <- "D"
 oceano[3, 1] <- "v"
 oceano[3, 2] <- "v"
 oceano[3, 3] <- "B"
 oceano[3, 4] <- "N"
 oceano[3, 5] <- "v"
 
 oceano[4, 0] <- "D"
 oceano[4, 1] <- "E"
 oceano[4, 2] <- "E"
 oceano[4, 3] <- "E"
 oceano[4, 4] <- "v"
 oceano[4, 5] <- "v"

 oceano[5, 0] <- "N"
 oceano[5, 1] <- "N"
 oceano[5, 2] <- "v"
 oceano[5, 3] <- "v"
 oceano[5, 4] <- "v"
 oceano[5, 5] <- "B"

 chance <- 5
 totalNa <- 0

 repita
   escreval("Primeira Coordenada")
   leia(posicao1)

   escreval("Segunda Coordenada")
   leia(posicao2)

   posicaoUser <- oceano[posicao1, posicao2]
 
   se(posicaoUser = "v") entao
     chance <- chance - 1
     escreval("Nada! Quantidade de chances: ", chance)
    senao
     totalNa <- totalNa + 1 
      escreval("Acertou: ", posicaoUser, "Total de acertos: ", totalNa)
   fimse
 ate(chance = 0 ou totalNa = 13)

  se(chance = 0) entao
    escreval("Voce Perdeu!")
  senao
    escreval("Harikkite Ikou!")
  fimse
fimalgoritmo
